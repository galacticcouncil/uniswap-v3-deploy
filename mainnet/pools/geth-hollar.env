# GETH/HOLLAR — per-pool settings only (runbook-cl-pool-launch §1).
# Shared settings and DEPLOYER_PK live in ENV_FILE (see .env.pools.example).
POOL_NAME=geth-hollar
TOKEN_A=420
TOKEN_B=222
FEE=3000
# By contract address HOLLAR (0x531a…) sorts before GETH (0x8a59…): HOLLAR is token0.
EXPECT_TOKEN0=222
EXPECT_TOKEN1=420
# GETH has no USD feed: this is the money market's AaveOracle, which prices the
# 2-POOL-GETH share token (stableswap 4200 -> aETH x ETH/USD). Age comes from the
# ETH/USD leg 0x1AF549Fe19A9B73D094173C41e18BF7F357F594b.
PRICE_FEED_A=0xAD33C0F0C42C5A0EAA65b5895D2BdB20cb6E8760
PRICE_FEED_B=
# §1e: ETH/USD age p90 4.5h, max 9.6h.
STALE_SECONDS=57600
OBS_CARDINALITY=2000
