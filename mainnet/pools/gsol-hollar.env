# GSOL/HOLLAR — per-pool settings only (runbook-cl-pool-launch §1).
# Shared settings and DEPLOYER_PK live in ENV_FILE (see .env.pools.example).
POOL_NAME=gsol-hollar
TOKEN_A=9001
TOKEN_B=222
FEE=3000
# By contract address HOLLAR (0x531a…) sorts before GSOL (0xf5f7…): HOLLAR is token0.
EXPECT_TOKEN0=222
EXPECT_TOKEN1=9001
# GSOL has no USD feed: this is the money market's AaveOracle, which prices the
# 2-POOL-GSOL share token (stableswap 90001 -> aSOL x SOL/USD). Age comes from the
# SOL/USD leg 0x2FAA73BCC0115b9F67d2f36E53738B7FF95f0D2C.
PRICE_FEED_A=0xAD33C0F0C42C5A0EAA65b5895D2BdB20cb6E8760
PRICE_FEED_B=
# §1e: SOL/USD age p90 2.2h, max 3.2h.
STALE_SECONDS=28800
OBS_CARDINALITY=2000
