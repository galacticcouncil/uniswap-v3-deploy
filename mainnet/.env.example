# Network ---------------------------------------------------------------
# mainnet:  wss://rpc.hydradx.cloud  /  https://rpc.hydradx.cloud (EVM)
# lark:     wss://1.lark.hydration.cloud / https://1.lark.hydration.cloud
NET=mainnet
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud

# Deployer --------------------------------------------------------------
# Must be whitelisted in EVMAccounts::ContractDeployer (01-governance-calldata.js whitelist)
# and hold WETH (asset 20) for gas.
DEPLOYER_PK=
# Post-deploy owner of factory/ProxyAdmin (governance-controlled EVM address).
# Defaults to the deployer if unset — transfer later.
OWNER_ADDRESS=

# Pool ------------------------------------------------------------------
# Mainnet asset ids: DOT=5, HOLLAR=222, WETH(gas)=20.
TOKEN_A=5
TOKEN_B=222
FEE=3000

# Init price: TOKEN_B per 1 TOKEN_A in human units (e.g. HOLLAR per DOT).
# Prefer DIA; PRICE alone works, both = cross-check (abort on divergence).
PRICE=
# DIA DOT/USD feed (HOLLAR assumed 1 USD unless DIA_KEY_B set).
DIA_FEED=
DIA_KEY=DOT/USD
DIA_KEY_B=
MAX_DIVERGENCE_BPS=200
STALE_SECONDS=3600

# TWAP ring buffer target (600 slots ~= 1h at 6s blocks), grown in chunks.
OBS_CARDINALITY=600
OBS_CHUNK=250

# Deploy CLI ------------------------------------------------------------
CONFIRMATIONS=2
