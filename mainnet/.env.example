# Network ---------------------------------------------------------------
# mainnet:  wss://rpc.hydradx.cloud  /  https://rpc.hydradx.cloud (EVM)
# lark:     wss://1.lark.hydration.cloud / https://1.lark.hydration.cloud
NET=mainnet
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud

# Deployer --------------------------------------------------------------
# Must be whitelisted in EVMAccounts::ContractDeployer (01-governance-calldata.js whitelist)
# and hold WETH (asset 20) for gas.
DEPLOYER_PK=
# Post-deploy owner of factory + ProxyAdmin. MUST be a governance-controlled EVM
# address on mainnet -- 02-deploy.js refuses to run with the deployer as owner.
#
# Hydration lets a Substrate account call evm.call as the EVM address that shares
# its first 20 bytes (runtime EnsureAddressTruncated). The governance dispatch
# accounts are picked so their prefix IS a usable EVM address:
#
#   0xaa7e0000000000000000000000000000000aa7e0  dispatcher.dispatchAsAaveManager
#       origin: Root or EconomicParameters. Already the Aave market's ACLManager
#       admin, and "economic parameters" is exactly what setFeeProtocol is.
#   0x6d6f646c70792f74727372790000000000000000  dispatcher.dispatchAsTreasury
#       origin: Root or Treasurer. ("modl" ++ "py/trsry" ++ zero padding.)
#
# A WRONG owner does not revert the referendum -- the dispatcher returns Ok and
# the inner evm.call fails silently (this bricked money-market ref 322).
OWNER_ADDRESS=0xaa7e0000000000000000000000000000000aa7e0

# Escape hatch: allow deploying with the deployer key as owner. Testnets only.
ALLOW_DEPLOYER_OWNER=false

# Pool ------------------------------------------------------------------
# Mainnet asset ids: aDOT=1001, HOLLAR=222, DOT=5, WETH(gas)=20.
# The launch pair is aDOT/HOLLAR. Ordering flips vs a DOT test pool: token0/
# token1 is the raw address sort, and the address is the asset id in its last
# 4 bytes, so it is an id sort. 5 < 222 puts DOT first, but 222 < 1001 puts
# HOLLAR first -- every tick sign inverts with it. Assert it below.
TOKEN_A=1001
TOKEN_B=222
FEE=3000

# Ordering guard for 03-create-pool.js: asset ids in pool order (token0, token1).
# Leave blank to skip the assertion -- do not do that on mainnet.
EXPECT_TOKEN0=222
EXPECT_TOKEN1=1001

# Protocol fee DENOMINATOR -- bigger number = smaller fee. 0 = off, else 4..10.
# 4 = 1/4 = 25% (the contract maximum) and is what we launch with; 10 = 1/10.
# Used as the default for `04-owner-ops.js set-fee-protocol` (both tokens), and
# checked against the live pool by 03-create-pool.js.
FEE_PROTOCOL=4

# Init price: TOKEN_B per 1 TOKEN_A in human units (e.g. HOLLAR per aDOT).
# Prefer the feed; PRICE alone works, both = cross-check (abort on divergence).
PRICE=

# Price feeds are Chainlink AggregatorV3 -- latestRoundData(), NOT DIA
# getValue(string). DIA supplies the data; Hydration serves it through the
# AggregatorV3 interface, the same feeds the Aave market reads. Every mainnet
# feed reverts on getValue() (checked 2026-08-21), so ONE CONTRACT PER PAIR and
# no key strings.
#
# PRICE_FEED_A = TOKEN_A/USD. aDOT is 1:1 with DOT (the balance rebases, the
# price does not), so the DOT/USD feed IS the aDOT price -- no index factor.
#   mainnet DOT/USD  0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702  (8 dec)
PRICE_FEED_A=0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702
# PRICE_FEED_B = TOKEN_B/USD. Leave blank for HOLLAR: it is the USD-pegged side,
# so A/USD is the pool price directly. Set it if TOKEN_B ever needs its own feed.
PRICE_FEED_B=
MAX_DIVERGENCE_BPS=200
STALE_SECONDS=3600

# TWAP observation ring ("logbook"), grown in chunks.
#
# The pool writes AT MOST ONE observation per block, and only on blocks that
# traded. With cardinality C the oldest observation sits C-1 slots behind the
# newest, so a full ring covers (C - 1) * BLOCK_TIME_SECS. Asking observe() for
# anything older than that REVERTS with 'OLD' -- it does not return what it has.
#
# So the floor is (TWAP_WINDOW_SECS / BLOCK_TIME_SECS) + 1: 601 for a 1h window
# at 6s blocks. 600 is one slot short and fails. 720 leaves ~12 min of headroom.
# 03-create-pool.js derives the floor from the two values below and refuses to
# run under it.
#
# Counter-intuitive: DENSE trading is the failure case. Pages are only spent on
# blocks that traded, so thin flow stretches the ring further back -- the revert
# arrives exactly when the pool starts attracting continuous flow.
#
# TWAP_WINDOW_SECS must match ClearingV2's twapInterval in gamma-hypervisor
# (contract default 3600) and the keeper's TWAP_WINDOW_SECS. There is no shared
# constant across the repos; this is the one place they get reconciled.
TWAP_WINDOW_SECS=3600
BLOCK_TIME_SECS=6
OBS_CARDINALITY=720
OBS_CHUNK=250

# Deploy CLI ------------------------------------------------------------
CONFIRMATIONS=2

# Testnet-only (05/06/07, lark forks) --------------------------------------
# 05 refuses to run unless Parameters::IsTestnet is true.
GOV_SURI=//Alice
VOTE_HDX=3000000000
ENACT_AFTER=1
GAS_ASSET_ID=20
FUND_GAS=100000000000000000000
FUND_A=2000000000000000          # TOKEN_A raw units (aDOT/DOT are both 10 dec)
FUND_B=200000000000000000000000

# 06-seed-position.js — amounts must match PRICE or the excess is refunded.
SEED_A=1000000000000000
SEED_B=87270000000000000000000

# 07-smoke-test.js
SMOKE_AMOUNT_A=10000000000000

# lark: estimateGas under-shoots mint/CREATE; approvals use the u128 sentinel.
EVM_GAS_LIMIT=10000000
