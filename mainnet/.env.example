# Copy to a separately named, untracked file such as .env.mainnet. Run every
# command with ENV_FILE=.env.mainnet so a fork configuration cannot be used by
# accident.

# Target -----------------------------------------------------------------
NET=mainnet
CHAIN_ID=222222
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud

# Deployer ---------------------------------------------------------------
# The EVM account must hold WETH (asset 20) for gas. A fixed gas limit means
# deployment does not use Hydration's RPC-only CREATE simulation/allowlist.
DEPLOYER_PK=

# The deploy CLI transfers both the factory and ProxyAdmin to this address.
# Hydration's dispatcher Aave-manager account is the production owner used for
# economic-parameter governance calls.
OWNER_ADDRESS=0xaa7e0000000000000000000000000000000aa7e0
ALLOW_DEPLOYER_OWNER=false

# Launch pool ------------------------------------------------------------
# aDOT (asset 1001) and HOLLAR (asset 222) are Erc20-kind assets. Their
# registry contracts, not their asset-ID aliases, are the pool tokens.
TOKEN_A=1001
TOKEN_B=222
FEE=3000
EXPECT_TOKEN0=1001
EXPECT_TOKEN1=222

# 0 = off; otherwise 4..10. Four takes 1/4 of swap fees for the protocol.
FEE_PROTOCOL=4

# Initial pool price: TOKEN_B per one TOKEN_A. The chain's DOT/USD
# AggregatorV3 feed is valid for aDOT (aDOT rebases 1:1 with DOT). Leave
# PRICE blank to use the feed; set it as an independent cross-check if wanted.
PRICE=
PRICE_FEED_A=0xFBCa0A6dC5B74C042DF23025D99ef0F1fcAC6702
# Leave blank only when TOKEN_B is deliberately treated as USD-pegged.
PRICE_FEED_B=
MAX_DIVERGENCE_BPS=200
STALE_SECONDS=28800

# TWAP observation ring --------------------------------------------------
# A full ring needs ceil(TWAP_WINDOW_SECS / BLOCK_TIME_SECS) + 1 entries.
# 2000 entries cover 3998 seconds at Hydration's two-second block time.
TWAP_WINDOW_SECS=3600
BLOCK_TIME_SECS=2
OBS_CARDINALITY=2000
OBS_CHUNK=250

# Transaction policy -----------------------------------------------------
# All v3 deployment and pool writes use legacy gasPrice = eth_gasPrice times
# this multiplier and this fixed gas limit. The runtime's EVM block cap is 20m.
GAS_PRICE_MULT=4
EVM_GAS_LIMIT=15000000
CONFIRMATIONS=2
