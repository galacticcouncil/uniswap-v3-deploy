# Every .env variant — real runs carry DEPLOYER_PK. `.env` alone missed
# backups like .env.backup-dothollar and .env.lark4.
.env*
!.env.example
!.env.pools.example
node_modules/
# Deployment records are the launch archive — the addresses are nonce-derived
# and exist nowhere else. Keep the JSON, keep everything else out.
deployments/*
!deployments/*.json
# A chopsticks rehearsal writes its own record; never commit it.
deployments/fork*.json
