# Shared settings for pools 2-5 on the LIVE, registered factory. Copy to
# .env.pools, set DEPLOYER_PK, and pass ONE pool file alongside:
#
#   ENV_FILE=.env.pools ./launch-pool.sh pools/atbtc-hollar.env
#
# Per-pool keys (lib.js POOL_KEYS: TOKEN_A/B, FEE, EXPECT_TOKEN0/1, PRICE,
# PRICE_FEED_A/B, STALE_SECONDS, OBS_CARDINALITY, POOL_NAME) must NOT appear
# here: the scripts refuse to run if they do.
NET=mainnet
CHAIN_ID=222222
WS_URL=wss://rpc.hydradx.cloud
EVM_RPC_URL=https://rpc.hydradx.cloud
DEPLOYER_PK=
OWNER_ADDRESS=0xaa7e0000000000000000000000000000000aa7e0
ALLOW_DEPLOYER_OWNER=false
FEE_PROTOCOL=4
MAX_DIVERGENCE_BPS=200
TWAP_WINDOW_SECS=3600
BLOCK_TIME_SECS=2
OBS_CHUNK=250
# economic_parameters (track 9) is all a pool bundle needs; root escalates it.
GOVERNANCE_TRACK=economic_parameters
GAS_PRICE_MULT=4
EVM_GAS_LIMIT=15000000
CONFIRMATIONS=2
